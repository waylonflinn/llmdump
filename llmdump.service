[Unit]
Description=mitmproxy LLM capture
After=network-online.target

[Service]
# llmdump.env is the shared config (also sourced by llmdump.sh and the launchd
# plist wrapper). systemd reads it directly so vars are set in the service's
# environment regardless of linger / boot-time auto-start.
EnvironmentFile=%h/.local/share/llmdump/llmdump.env
ExecStart=/usr/bin/mitmdump -p 9501 -s %h/.local/share/llmdump/dump_llm_stream.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
