# llmdump capture configuration -- shared by llmdump.sh, the launchd plist
# wrapper, and the systemd unit (EnvironmentFile=). Paths are absolute because
# systemd does not perform variable expansion in EnvironmentFile values.

LLMDUMP_CAPTURE_DIR="/Users/USER/.cache/llmdump/capture/"
LLMDUMP_FLAG_FILE="/Users/USER/.local/share/llmdump/capture.flag"
